}

object house {
    name house_host_2;
    parent meter_h2;
    heating_system_type NONE;
    cooling_system_type NONE;
    auxiliary_system_type NONE;
    object waterheater {
        name wh_2;
        location INSIDE;
        tank_volume 50.0;
        tank_setpoint 120.0;
        thermostat_deadband 2.0;
        heating_element_capacity 4.5 kW;
        inlet_water_temperature 60.0;
        tank_UA 3.0;
        temperature 120.0;
        object player {
            property water_demand;
            file "house_2_water.player";
        };
    };
}

