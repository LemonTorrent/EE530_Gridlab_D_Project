// EE 5/430 Term Project - Initial 3-House GridLAB-D Model
// Run example (Constant Power):
//   gridlabd -D Z_FRAC=0.0 -D I_FRAC=0.0 -D P_FRAC=1.0 -D CASE_NAME=const_P -D XFMR_KVA=25 three_house_base.glm

#ifndef Z_FRAC
#define Z_FRAC=0.0
#endif
#ifndef I_FRAC
#define I_FRAC=0.0
#endif
#ifndef P_FRAC
#define P_FRAC=1.0
#endif
#ifndef CASE_NAME
#define CASE_NAME=const_P
#endif
#ifndef XFMR_KVA
#define XFMR_KVA=25
#endif

clock {
    timezone PST+8PDT;
    starttime '2025-09-01 00:00:00';
    stoptime  '2025-09-01 23:59:00';
}

module tape;
module residential {
    implicit_enduses NONE;
}
module powerflow {
    solver_method NR;
}

// --- Primary Source & Center-Tapped Transformer ---
object node {
    name primary_source;
    bustype SWING;
    phases AS;
    nominal_voltage 7200;
}

object transformer_configuration {
    name spct_config;
    connect_type SINGLE_PHASE_CENTER_TAPPED;
    install_type POLETOP;
    power_rating ${XFMR_KVA};
    primary_voltage 7200;
    secondary_voltage 120;
    resistance 0.011;
    reactance 0.020;
}

object transformer {
    name shared_xfmr;
    phases AS;
    from primary_source;
    to xfmr_secondary;
    configuration spct_config;
}

object triplex_node {
    name xfmr_secondary;
    phases AS;
    nominal_voltage 120;
}

// --- Service Drop Line Configuration ---
object triplex_line_conductor {
    name tp_conductor;
    resistance 0.97;
    geometric_mean_radius 0.0111;
}

object triplex_line_configuration {
    name tp_line_config;
    conductor_1 tp_conductor;
    conductor_2 tp_conductor;
    conductor_N tp_conductor;
    insulation_thickness 0.08;
    diameter 0.368;
}

// ==========================================
// HOUSE 1
// ==========================================
object triplex_line {
    name line_h1;
    phases AS;
    from xfmr_secondary;
    to meter_h1;
    length 50 ft;
    configuration tp_line_config;
}

object triplex_meter {
    name meter_h1;
    phases AS;
    nominal_voltage 120;
}

object triplex_load {
    name load_h1;
    parent meter_h1;
    phases AS;
    nominal_voltage 120;
    impedance_fraction_12 ${Z_FRAC};
    current_fraction_12   ${I_FRAC};
    power_fraction_12     ${P_FRAC};
    impedance_pf_12 0.95;
    current_pf_12   0.95;
    power_pf_12     0.95;
    object player {
        property base_power_12;
        file "house_1_load.player";
    };
}

object house {
    name house_host_1;
    parent meter_h1;
    heating_system_type NONE;
    cooling_system_type NONE;
    auxiliary_system_type NONE;
    object waterheater {
        name wh_1;
        location INSIDE;
        tank_volume 50.0;
        tank_setpoint 120.0;
        thermostat_deadband 2.0;
        heating_element_capacity 4.5 kW;
        inlet_water_temperature 60.0;
        tank_UA 3.0;
        temperature 120.0;
        object player {
            property water_demand;
            file "house_1_water.player";
        };
    };
}

// ==========================================
// HOUSE 2
// ==========================================
object triplex_line {
    name line_h2;
