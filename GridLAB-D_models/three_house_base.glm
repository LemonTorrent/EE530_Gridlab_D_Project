    };
}

// ==========================================
// RECORDERS (1-minute interval)
// ==========================================
object recorder {
    parent shared_xfmr;
    property power_in.real,power_in.imag,current_in_A.mag;
    interval 60;
    file "out_${CASE_NAME}_${XFMR_KVA}kVA_xfmr.csv";
}

object recorder {
    parent meter_h1;
    property measured_real_power,measured_reactive_power,voltage_12.mag,measured_current_1.mag;
    interval 60;
    file "out_${CASE_NAME}_${XFMR_KVA}kVA_m1.csv";
}

object recorder {
    parent meter_h2;
    property measured_real_power,measured_reactive_power,voltage_12.mag,measured_current_1.mag;
    interval 60;
    file "out_${CASE_NAME}_${XFMR_KVA}kVA_m2.csv";
}

object recorder {
    parent meter_h3;
    property measured_real_power,measured_reactive_power,voltage_12.mag,measured_current_1.mag;
    interval 60;
    file "out_${CASE_NAME}_${XFMR_KVA}kVA_m3.csv";
}

object recorder {
    parent wh_1;
    property actual_power,temperature,water_demand;
    interval 60;
    file "out_${CASE_NAME}_${XFMR_KVA}kVA_wh1.csv";
}

object recorder {
    parent wh_2;
    property actual_power,temperature,water_demand;
    interval 60;
    file "out_${CASE_NAME}_${XFMR_KVA}kVA_wh2.csv";
}

object recorder {
    parent wh_3;
    property actual_power,temperature,water_demand;
    interval 60;
    file "out_${CASE_NAME}_${XFMR_KVA}kVA_wh3.csv";
}