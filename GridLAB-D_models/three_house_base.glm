// EE 5/430 Term Project - Profile-driven GridLAB-D Model
// Run example (Constant Power):
//   python python_scripts/prepare_players.py
//   gridlabd -D Z_FRAC=0.0 -D I_FRAC=0.0 -D P_FRAC=1.0 -D CASE_NAME=const_P -D XFMR_KVA=25 GridLAB-D_models/three_house_base.glm

#ifndef Z_FRAC
#define Z_FRAC=0.0
#endif
#ifndef I_FRAC
#define I_FRAC=0.0
#endif
#ifndef P_FRAC
#define P_FRAC=1.0
#endif
#ifndef CASE_NAME
#define CASE_NAME=const_P
#endif
#ifndef XFMR_KVA
#define XFMR_KVA=25
#endif

clock {
    timezone PST+8PDT;
    starttime '2025-09-01 00:00:00';
    stoptime  '2025-09-02 00:00:00';
}

module tape;
module residential {
    implicit_enduses NONE;
}
module powerflow {
    solver_method NR;
}

// --- Primary Source & Center-Tapped Transformer ---
object node {
    name primary_source;
    bustype SWING;
    phases AN;
    nominal_voltage 7200;
}

object transformer_configuration {
    name spct_config;
    connect_type SINGLE_PHASE_CENTER_TAPPED;
    install_type POLETOP;
    power_rating ${XFMR_KVA};
    primary_voltage 7200;
    secondary_voltage 120;
    resistance 0.011;
    reactance 0.020;
}

object transformer {
    name shared_xfmr;
    phases AS;
    from primary_source;
    to xfmr_secondary;
    configuration spct_config;
}

object triplex_node {
    name xfmr_secondary;
    phases AS;
    nominal_voltage 120;
}

// --- Service Drop Line Configuration ---
object triplex_line_conductor {
    name tp_conductor;
    resistance 0.97;
    geometric_mean_radius 0.0111;
}

object triplex_line_configuration {
    name tp_line_config;
    conductor_1 tp_conductor;
    conductor_2 tp_conductor;
    conductor_N tp_conductor;
    insulation_thickness 0.08;
    diameter 0.368;
}

// House objects and recorders are generated by python_scripts/prepare_players.py.
#include "GridLAB-D_models/generated_houses.glm"

// ==========================================
// RECORDERS (1-minute interval)
// ==========================================
object recorder {
    parent shared_xfmr;
    property power_in,current_in_A;
    interval 60;
    file "out_${CASE_NAME}_${XFMR_KVA}kVA_xfmr.csv";
}